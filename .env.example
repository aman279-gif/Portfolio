# ==========================================
# PORTFOLIO BACKEND & EMAIL CONFIGURATION
# ==========================================

# Express Server Port (default 5001 avoids macOS AirPlay ControlCenter conflict on 5000)
PORT=5001

# Allowed Frontend URL for CORS (e.g., http://localhost:5173 in dev or your production domain)
FRONTEND_URL=http://localhost:5173

# Email Service Provider (default: gmail)
EMAIL_SERVICE=gmail

# Your Gmail address that will authenticate and send the notification email
EMAIL_USER=your-email@gmail.com

# Gmail App Password (16 characters generated from Google Account > Security > 2-Step Verification > App passwords)
# NOTE: Do NOT use your personal Gmail login password! Use a dedicated App Password.
EMAIL_PASS=your-16-character-app-password

# The email address where you want to receive portfolio contact inquiries
RECEIVER_EMAIL=mauryaman279@gmail.com

# ------------------------------------------
# OPTIONAL: Custom SMTP Server Configuration
# (Only needed if NOT using Gmail or EMAIL_SERVICE)
# ------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false

# ------------------------------------------
# OPTIONAL: Frontend API URL
# Leave blank to use the Vite proxy (/api) in development
# In production, set to your deployed backend URL (e.g., https://api.yourdomain.com)
# ------------------------------------------
VITE_API_URL=
